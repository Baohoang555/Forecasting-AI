    def test_forecast_cohort_only_uses_latest_three_calendar_months(self):
        rows = []
        for month in pd.period_range("2026-01", "2026-04", freq="M"):
            rows.append({"employee_id": "A", "month": month, "department": "D", "N44": 1, "N70": 0,
                         "total_meals": 1, "days_with_meal": 1, "total_amount": 44000, "is_complete_month": True})
        rows.append({"employee_id": "OLD", "month": pd.Period("2026-01", freq="M"), "department": "D", "N44": 1, "N70": 0,
                     "total_meals": 1, "days_with_meal": 1, "total_amount": 44000, "is_complete_month": True})
        df = pd.DataFrame(rows)
        out = predict.build_forecast_feature_row(df, pd.Period("2026-05", freq="M"), pd.Period("2026-04", freq="M"))
        self.assertEqual(out.employee_id.tolist(), ["A"])

    def test_monitor_keeps_unmatched_ids_in_company_totals(self):
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            forecast_path = tmp / "forecast.csv"
            pd.DataFrame({"employee_id": ["A", "F"], "forecast_month": ["2026-04", "2026-04"],
                          "pred_cost": [100.0, 50.0]}).to_csv(forecast_path, index=False)
            actual = pd.DataFrame({"employee_id": ["A", "X"], "month": [pd.Period("2026-04", freq="M")]*2,
                                   "N44": [0, 0], "N70": [0, 0], "total_amount": [80.0, 20.0]})
            monthly_path = tmp / "monthly.parquet"
            monthly_path.touch()
            with patch.object(monitor.pd, "read_parquet", return_value=actual):
                row = monitor.run_monitor(forecast_path, monthly_path, output_dir=tmp / "metrics")
            self.assertEqual(row["n_forecast_only"], 1)
            self.assertEqual(row["n_actual_only"], 1)
            self.assertEqual(row["forecast_total_cost_all"], 150.0)
            self.assertEqual(row["actual_total_cost_all"], 100.0)
            comparison = pd.read_csv(tmp / "metrics" / "forecast_accuracy_employees_2026-04.csv")
            self.assertEqual(set(comparison.status), {"matched", "forecast_only", "actual_only"})

    def test_monitor_rejects_duplicate_forecast_employee(self):
        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            forecast_path = tmp / "forecast.csv"
            pd.DataFrame({"employee_id": ["A", "A"], "forecast_month": ["2026-04"]*2,
                          "pred_cost": [100.0, 120.0]}).to_csv(forecast_path, index=False)
            monthly_path = tmp / "monthly.parquet"
            monthly_path.touch()
            with patch.object(monitor.pd, "read_parquet", return_value=pd.DataFrame({"employee_id": ["Z"], "month": [pd.Period("2026-04", freq="M")]})):
                with self.assertRaisesRegex(ValueError, "trùng"):
                    monitor.run_monitor(forecast_path, monthly_path, output_dir=tmp / "metrics")


