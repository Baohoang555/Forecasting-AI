    def test_hr_filter_excludes_non_roster_rows_and_guards_bad_match_rate(self):
        with tempfile.TemporaryDirectory() as tmp:
            hr_path = Path(tmp) / "hr.xlsx"
            hr_path.touch()
            forecast = pd.DataFrame({"employee_id": [1, 2, 3]})
            with patch.object(
                predict.pd,
                "read_excel",
                return_value=pd.DataFrame({"Mã NV": [1, 2]}),
            ):
                included, excluded = predict.split_by_hr_roster(
                    forecast, hr_path, max_excluded_share=0.4
                )
                self.assertEqual(included["employee_id"].tolist(), [1, 2])
                self.assertEqual(excluded["employee_id"].tolist(), [3])
                with self.assertRaisesRegex(ValueError, "vượt ngưỡng an toàn"):
                    predict.split_by_hr_roster(
                        forecast, hr_path, max_excluded_share=0.2
                    )

    def test_holiday_calendar_reads_recognized_date_column(self):
        sys.path.insert(0, str(ROOT / "src"))
        from calendar_utils import load_calendar_table

        with tempfile.TemporaryDirectory() as tmp:
            calendar_path = Path(tmp) / "holidays.xlsx"
            pd.DataFrame(
