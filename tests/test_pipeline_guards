class ForecastGuardsTest(unittest.TestCase):
    def test_complete_month_flag_parses_false_string_as_false(self):
        parsed = predict.normalize_complete_flag(pd.Series(["True", "False", "0", "yes"]))
        self.assertEqual(parsed.tolist(), [True, False, False, True])

    def test_requires_explicit_complete_month_flag(self):
        with self.assertRaisesRegex(ValueError, "is_complete_month"):
            predict.get_last_complete_month(pd.DataFrame({"employee_id": [1], "month": ["2026-01"]}))

    def test_no_complete_month_fails_closed(self):
        df = pd.DataFrame({"employee_id": [1], "month": ["2026-01"], "is_complete_month": [False]})
        with self.assertRaisesRegex(ValueError, "Không có tháng hoàn chỉnh được xác nhận"):
            predict.get_last_complete_month(df)

    def test_round_predictions_without_invalid_workday_cap(self):
        n44, n70 = predict.cap_and_round_meals(
            [12.7, -3, 0.4, 50], [12.7, 4, 0.4, 50], [20, 10, 1, 0]
        )
        self.assertTrue(np.all(n44 >= 0))
        self.assertTrue(np.all(n70 >= 0))
        self.assertEqual(n44.tolist(), [13, 0, 0, 50])
        self.assertEqual(n70.tolist(), [13, 4, 0, 50])
        self.assertGreater(n44[-1] + n70[-1], 0)

    def test_production_features_include_backtest_department_encodings(self):
        self.assertIn("dept_enc_n44", predict.MODEL_FEATURES)
        self.assertIn("dept_enc_n70", predict.MODEL_FEATURES)

